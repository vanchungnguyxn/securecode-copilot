# Copy to VPS as .env next to docker-compose.prod.yml (or let CI generate it).
BACKEND_IMAGE=ghcr.io/OWNER/securecode-copilot-backend:latest
FRONTEND_IMAGE=ghcr.io/OWNER/securecode-copilot-frontend:latest
LLM_PROVIDER=heuristic
USE_ML_DETECTOR=false
USE_ML_DISCOVERY=false
CORS_ORIGINS=https://your-domain.example
DATABASE_URL=sqlite:///./data/scc.db
JWT_SECRET=replace-with-long-random-secret
BILLING_MOCK=true
APP_URL=https://your-domain.example
HTTP_PORT=80
