# LLM_PROVIDER=local sau khi đã fine-tune checkpoint
LLM_PROVIDER=heuristic
USE_ML_DETECTOR=true
OPENAI_API_KEY=
MODEL_PATH=../ml/inference/checkpoints/codet5-lora
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
APP_URL=http://localhost:5173

# Database — SQLite for local; Postgres for production
DATABASE_URL=sqlite:///./scc.db
# DATABASE_URL=postgresql+psycopg://scc:scc@localhost:5432/scc

# Auth
JWT_SECRET=dev-change-me-scc-jwt-secret-min-32-chars!!
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=14

# Email (stub — logs mock links in console when disabled)
EMAIL_ENABLED=false
EMAIL_SERVER=
EMAIL_FROM=noreply@securecode.local

# Billing — mock checkout until Stripe is wired
BILLING_MOCK=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
