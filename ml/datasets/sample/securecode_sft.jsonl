{"id": "py-sqli-1", "language": "python", "cwe": "CWE-89", "severity": "critical", "vulnerable_code": "cursor.execute(f\"SELECT * FROM users WHERE id = {user_id}\")", "secure_code": "cursor.execute(\"SELECT * FROM users WHERE id = ?\", (user_id,))", "explanation": "f-string SQL is injectable; use parameterized query.", "task": "detect_explain_fix"}
